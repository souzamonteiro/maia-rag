[Unit]
Description=Maia RAG Inbox Watcher
After=maia-rag.service

[Service]
Type=simple
User=maia
Group=maia
WorkingDirectory=/opt/maia-rag
EnvironmentFile=-/etc/maia-rag.env
ExecStart=/usr/bin/node /opt/maia-rag/src/watcher/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maia-rag/data

[Install]
WantedBy=multi-user.target
