[Unit]
Description=Maia RAG Qdrant Vector Database
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maia
Group=maia
WorkingDirectory=/srv/maia/maia-rag/data
Environment=QDRANT__STORAGE__STORAGE_PATH=/srv/maia/maia-rag/data/qdrant
Environment=QDRANT__SERVICE__HOST=127.0.0.1
Environment=QDRANT__SERVICE__HTTP_PORT=6333
ExecStart=/srv/maia/maia-rag/bin/qdrant
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/maia/maia-rag/data

[Install]
WantedBy=multi-user.target

