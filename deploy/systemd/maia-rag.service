[Unit]
Description=Maia RAG API and Web UI
After=network-online.target maia-qdrant.service ollama.service
Wants=network-online.target
Requires=maia-qdrant.service

[Service]
Type=simple
User=maia
Group=maia
WorkingDirectory=/srv/maia/maia-rag
EnvironmentFile=-/srv/maia/maia-rag/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/maia/maia-rag/data

[Install]
WantedBy=multi-user.target

