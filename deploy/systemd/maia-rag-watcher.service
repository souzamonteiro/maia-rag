[Unit]
Description=Maia RAG Inbox Watcher
After=network-online.target maia-rag.service
Wants=network-online.target
Requires=maia-rag.service

[Service]
Type=simple
User=maia
Group=maia
WorkingDirectory=/srv/maia/maia-rag
EnvironmentFile=-/srv/maia/maia-rag/.env
ExecStart=/usr/bin/node src/watcher/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/maia/maia-rag/data

[Install]
WantedBy=multi-user.target

