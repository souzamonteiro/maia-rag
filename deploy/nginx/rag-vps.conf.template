# Install on the public Maia Edge VPS. Requires an existing TLS certificate.
server {
    listen 80;
    listen [::]:80;
    server_name rag.maiaplatform.org;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://rag.maiaplatform.org$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name rag.maiaplatform.org;
    ssl_certificate /etc/letsencrypt/live/rag.maiaplatform.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rag.maiaplatform.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Inherited by EVERY HTTPS location, including /api and static files.
    auth_basic "Maia RAG - Curadoria";
    auth_basic_user_file /etc/nginx/maia-rag.htpasswd;
    client_max_body_size 101m;
    add_header Cache-Control "no-store" always;

    location / {
        proxy_pass http://__RAG_WG_IP__:4311;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Credentials terminate here and never reach application logs.
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_cache off;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
    }
}
